# --------------------------------------------------
# MY-DEV-ENVIRONMENT .env.example
#
# Copy to .env in the project that needs it.
# NEVER commit .env itself. This file is the template.
# Real values go in the project's .gitignore'd .env (or a secrets manager).
# --------------------------------------------------

# --- Personal GitHub ---
# Personal access token used by `gh` or scripts that hit the GitHub API.
# Use fine-grained, short-lived tokens. Rotate on personnel changes.
GITHUB_TOKEN=<SECRET>

# --- Editor ---
# VS Code by default. Set to `vim`/`nano`/`code --wait` as appropriate.
EDITOR=code --wait

# --- Python / uv ---
# Override default uv cache directory if needed (mostly for CI).
# UV_CACHE_DIR=$HOME/.cache/uv

# --- Per-project overrides ---
# Anything specific to a single project should live in that project's
# own .env (or .env.local) and not be defined here.
DATABASE_URL=<PROJECT_SPECIFIC>
LOG_LEVEL=info